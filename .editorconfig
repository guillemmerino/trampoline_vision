# Convencions de l’editor: UTF-8 per als comentaris en català i finals de línia uniformes.
# No afecta els algoritmes; evita canvis de format accidentals entre equips.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
indent_size = 2

[*.json]
indent_size = 2
